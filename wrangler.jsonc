{
  // Cloudflare Worker for chartwright.de: website files (public/), waitlist and the Pro API (src/).
  // Production is the top level; the staging environment is under "env.staging".
  "name": "chartwright",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Error logs in Cloudflare (Workers Logs). Only runs of the Worker code are logged, not website files.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "chartwright-waitlist", "database_id": "b5cdacbd-0370-443b-8849-0d5213b8f67a", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "chartwright-blobs" }
  ],
  "ratelimits": [
    // Log-in, sign-up, password reset and waitlist: 10 attempts per minute per visitor
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Rest of the API: 300 requests per minute per visitor
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  // Account emails (confirm email, password reset, invitations) through Cloudflare Email Service.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@chartwright.de"] }
  ],
  "vars": {
    "BASE_URL": "https://chartwright.de",
    // Pro stays switched off in production until the launch is approved.
    // Before switching it on, fill in every [placeholder] in public/ (the tests check this).
    "PRO_ENABLED": "false",
    // Plan for workspaces without an entry in workspace_plan: "pro" (one admin, viewers) or "enterprise"
    "DEFAULT_PLAN": "pro",
    // Who may create a Pro account: "waitlist" (waitlist and invited people) or "open" (anyone)
    "SIGNUP_MODE": "waitlist",
    "EMAIL_FROM": "no-reply@chartwright.de",
    "EMAIL_FROM_NAME": "Chartwright",
    "EMAIL_REPLY_TO": "privacy@chartwright.de"
  },
  // Secret (set in Cloudflare, never in this file): BETTER_AUTH_SECRET

  "env": {
    "staging": {
      "name": "chartwright-staging",
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "chartwright-staging", "database_id": "48dd77bf-dec5-4b74-8320-a8e7e01f71d9", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "BLOBS", "bucket_name": "chartwright-blobs-staging" }
      ],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
      ],
      // Account emails (confirm email, password reset, invitations) through Cloudflare Email Service.
      "send_email": [
        { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@chartwright.de"] }
      ],
      "vars": {
        "BASE_URL": "https://chartwright-staging.sujoy-guha2.workers.dev",
        // Pro is on in staging so it can be tested before release.
        "PRO_ENABLED": "true",
        "DEFAULT_PLAN": "pro",
        "SIGNUP_MODE": "waitlist",
        "EMAIL_FROM": "no-reply@chartwright.de",
        "EMAIL_FROM_NAME": "Chartwright (staging)",
        "EMAIL_REPLY_TO": "privacy@chartwright.de"
      }
      // Secret for staging (set separately): BETTER_AUTH_SECRET
    }
  }
}
